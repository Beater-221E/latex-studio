{
  "name": "@local/latex-studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Project-level LaTeX workspace for DeepSeek Harness: edit a repository, build it with the right main file, preview the PDF and read diagnostics without leaving the app.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/service-smoke.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Beater-221E/latex-studio.git"
  },
  "homepage": "https://github.com/Beater-221E/latex-studio#readme",
  "bugs": {
    "url": "https://github.com/Beater-221E/latex-studio/issues"
  },
  "author": "Beater-221E",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "latex",
    "pdf",
    "preview",
    "annotation",
    "codex-style"
  ],
  "engines": {
    "node": ">=22"
  }
}
